// iOS Tests Configuration
PRODUCT_NAME = $(TARGET_NAME)
IPHONEOS_DEPLOYMENT_TARGET = 18.0
TARGETED_DEVICE_FAMILY = 1

// Swift settings
SWIFT_VERSION = 6
SWIFT_STRICT_CONCURRENCY = minimal
SWIFT_OPTIMIZATION_LEVEL = -Onone
SWIFT_COMPILATION_MODE = incremental

// Test settings
TEST_HOST = $(BUILT_PRODUCTS_DIR)/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/$(BUNDLE_EXECUTABLE_NAME)
BUNDLE_LOADER = $(TEST_HOST)
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @loader_path/Frameworks
ONLY_ACTIVE_ARCH = YES

// Disable Xcode compilation cache remote socket to avoid missing .sock hangs.
COMPILATION_CACHE_ENABLE_CACHING = NO
COMPILATION_CACHE_ENABLE_PLUGIN = NO
COMPILATION_CACHE_REMOTE_SERVICE_PATH =
