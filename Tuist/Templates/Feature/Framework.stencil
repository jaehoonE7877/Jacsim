import ComposableArchitecture

@Reducer
struct {{ name }}Feature {
    @ObservableState
    struct State: Equatable {
        init() {}
    }

    enum Action: Equatable {
        case onAppear
    }

    init() {}

    var body: some ReducerOf<Self> {
        Reduce { _, action in
            switch action {
            case .onAppear:
                return .none
            }
        }
    }
}
