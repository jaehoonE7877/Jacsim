import SwiftUI
import ComposableArchitecture

struct {{ name }}View: View {
    private let store: StoreOf<{{ name }}Feature>

    init(store: StoreOf<{{ name }}Feature>) {
        self.store = store
    }

    var body: some View {
        Text("{{ name }}")
            .onAppear {
                store.send(.onAppear)
            }
    }
}
